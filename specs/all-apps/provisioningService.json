  "components": {
    "schemas": {
      "CertificateInfoSpecification": {
        "required": [
          "certificate"
        ],
        "type": "object",
        "properties": {
          "certificate": {
            "type": "string",
            "description": "The certificate in string format.",
            "example": "PEM for X509Certificate"
          }
        },
        "description": "Specification for certificate for a cloud account.",
        "example": {
          "certificate": "-----BEGIN CERTIFICATE-----\nMIIDHjCCAoegAwIBAgIBATANBgkqhkiG9w0BAQsFADCBpjEUMBIGA1UEChMLVk13\nYXJlIEluYAAc1pw18GT3iAqQRPx0PrjzJhgjIJMla\n/1Kg4byY4FPSacNiRgY/FG2bPCqZk1yRfzmkFYCW/vU+Dg==\n-----END CERTIFICATE-----\n-"
        }
      },
      "IntegrationSpecification": {
        "required": [
          "integrationProperties",
          "integrationType",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "A human-friendly name used as an identifier in APIs that support this option."
          },
          "description": {
            "type": "string",
            "description": "A human-friendly description."
          },
          "integrationType": {
            "type": "string",
            "description": "Integration type",
            "example": "Active directory, Ansible, IPAM, vRO, GitHub"
          },
          "privateKeyId": {
            "type": "string",
            "description": "Access key id or username to be used to authenticate with the integration",
            "example": "ACDC55DB4MFH6ADG75KK"
          },
          "privateKey": {
            "type": "string",
            "description": "Secret access key or password to be used to authenticate with the integration",
            "example": "gfsScK345sGGaVdds222dasdfDDSSasdfdsa34fS"
          },
          "integrationProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "description": "Integration specific properties supplied in as name value pairs",
              "example": "{\"supportPublicImages\":\"true\",\"acceptSelfSignedCertificate\":\"true\"}"
            },
            "description": "Integration specific properties supplied in as name value pairs",
            "example": {
              "supportPublicImages": "true",
              "acceptSelfSignedCertificate": "true"
            }
          },
          "associatedCloudAccountIds": {
            "type": "array",
            "description": "Cloud accounts to associate with this integration",
            "example": [
              "42f3e0d199d134755684cd935435a"
            ],
            "items": {
              "type": "string",
              "description": "Cloud accounts to associate with this integration",
              "example": "[\"42f3e0d199d134755684cd935435a\"]"
            }
          },
          "customProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "description": "Additional custom properties that may be used to extend the Integration.",
              "example": "{\"sampleadapterProjectId\":\"projectId\"}"
            },
            "description": "Additional custom properties that may be used to extend the Integration.",
            "example": {
              "sampleadapterProjectId": "projectId"
            }
          },
          "tags": {
            "type": "array",
            "description": "A set of tag keys and optional values to set on the Integration",
            "example": [
              {
                "key": "env",
                "value": "dev"
              }
            ],
            "items": {
              "$ref": "#/components/schemas/Tag"
            }
          },
          "certificateInfo": {
            "$ref": "#/components/schemas/CertificateInfoSpecification"
          }
        },
        "description": "Specification for creating a generic integration.<br><br>Integration represents external system added to VMware Aria Automation and is identified by a type and specific properties."
      },
      "Tag": {
        "required": [
          "key",
          "value"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Tag's key."
          },
          "value": {
            "type": "string",
            "description": "Tag's value."
          },
          "id": {
            "type": "string",
            "description": "Tag's id.",
            "readOnly": true
          }
        },
        "description": "A set of tag keys and optional values that were set on the Integration",
        "example": [
          {
            "key": "env",
            "value": "dev"
          }
        ]
      },
      "RequestTracker": {
        "required": [
          "id",
          "progress",
          "selfLink",
          "status"
        ],
        "type": "object",
        "properties": {
          "progress": {
            "type": "integer",
            "description": "Progress of the request as percentage.",
            "format": "int32",
            "example": 90
          },
          "message": {
            "type": "string",
            "description": "Status message of the request.",
            "example": "In Progress"
          },
          "status": {
            "type": "string",
            "description": "Status of the request.",
            "example": "FINISHED",
            "enum": [
              "FINISHED",
              "INPROGRESS",
              "FAILED"
            ]
          },
          "resources": {
            "type": "array",
            "description": "Collection of resources.",
            "example": [
              "/resources/i-0be3655a12fd28e8e",
              "/resources/i-0be234a15ft8det3"
            ],
            "items": {
              "type": "string",
              "description": "Collection of resources.",
              "example": "[\"/resources/i-0be3655a12fd28e8e\",\"/resources/i-0be234a15ft8det3\"]"
            }
          },
          "name": {
            "type": "string",
            "description": "Name of the operation.",
            "example": "Power-off"
          },
          "id": {
            "type": "string",
            "description": "ID of this request.",
            "example": "we655aew4e8e"
          },
          "selfLink": {
            "type": "string",
            "description": "Self link of this request.",
